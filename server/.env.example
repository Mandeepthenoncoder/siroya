# Copy to server/.env and fill in. If server/.env is missing, the server
# creates it on first run with a random ADMIN_PASSWORD and SESSION_SECRET.
# Values are read as KEY=VALUE, one per line. Environment variables win
# over this file. Do not put comments on the same line as a value.

# Port to listen on (default 5173). `npm run dev` uses 5180.
PORT=5173

# Password for /admin/. Use 12 or more characters.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Signs the admin session cookie. 64 hex characters (32 random bytes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-hex-characters

# Optional: bind address (default all interfaces, so phones on the same
# Wi-Fi can open http://<your-computer-ip>:5173).
# HOST=127.0.0.1

# Optional: set to 1 only behind a reverse proxy (nginx, Caddy, Cloudflare)
# so client IPs and https come from X-Forwarded-For / X-Forwarded-Proto.
# TRUST_PROXY=1

# Optional: number of trusted proxies in front of Node (default 1), and the
# public address when a proxy rewrites Host without X-Forwarded-Host.
# TRUST_PROXY_HOPS=1
# PUBLIC_ORIGIN=https://siroya.vercel.app

# ---------------------------------------------------------------------------
# Production (Vercel). Set these in the Vercel dashboard, not in this file.
# Locally the server ignores them unless they are in your shell environment:
# without TURSO_DATABASE_URL it uses server/data/siroya.db, and without
# R2_ACCOUNT_ID it stores uploads in site/uploads/. See DEPLOY.md.
# ---------------------------------------------------------------------------
# TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
# TURSO_AUTH_TOKEN=<turso db tokens create ...>
# R2_ACCOUNT_ID=<Cloudflare account id>
# R2_ACCESS_KEY_ID=<R2 API token access key id>
# R2_SECRET_ACCESS_KEY=<R2 API token secret>
# R2_BUCKET=siroya-media
# R2_PUBLIC_URL=https://media.example.com   (bucket public URL, no trailing slash)
# CRON_SECRET=<random string; Vercel sends it to /api/cron/daily>
# Optional: set to 0 if R2 ever rejects uploads with a signed Content-Length.
# R2_SIGN_CONTENT_LENGTH=0
